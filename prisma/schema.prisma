generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String
  name              String?
  role              String   @default("parent") // parent or teacher
  isEmailVerified   Boolean  @default(false)
  verificationToken String?  @db.Text
  verificationExpiresAt DateTime?
  subscription      String   @default("FREE") // FREE or PREMIUM
  trialStartedAt    DateTime?
  premiumEndsAt     DateTime?
  premiumOrders     PremiumOrder[]
  children          Child[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model PremiumOrder {
  id String @id @default(cuid())
  code String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount Int
  days Int
  status String @default("PENDING")
  createdAt DateTime @default(now())
  expiresAt DateTime
  submittedAt DateTime?
  reviewedAt DateTime?
  reviewedBy String?
  bankReference String? @unique
  reviewNote String?
  grantedUntil DateTime?
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Child {
  id                      String    @id @default(cuid())
  activityEntries         ActivityEntry[]
  roadmaps                Roadmap[]
  appointments            Appointment[]
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                    String
  age                     Int
  dateOfBirth             DateTime?
  condition               String?
  developmentalChallenges String[]
  communicationLevel      String?   @default("Bình thường")
  avatar                  String    @default("🌻")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([userId])
}

model Resource {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String // "Kiến thức" or "Học liệu"
  ageGroup    String // JSON stringified array or comma separated string e.g. "0-3 tuổi,3-6 tuổi"
  difficulty  String // JSON stringified array or comma separated string
  format      String // "Video", "Bài viết", "PDF", "Hình ảnh"
  accessLevel String   @default("BASIC") // BASIC or PREMIUM
  imageUrl    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ActivityEntry {
  id String @id @default(cuid())
  childId String
  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  title String
  notes String
  minutes Int
  words Int @default(0)
  createdAt DateTime @default(now())
  @@index([childId, createdAt])
}
model Roadmap {
  id String @id @default(cuid())
  childId String
  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  goal String
  content Json
  createdAt DateTime @default(now())
  @@index([childId, createdAt])
}

model Appointment {
 id String @id @default(cuid())
 childId String
 child Child @relation(fields:[childId],references:[id],onDelete:Cascade)
 requestedAt DateTime
 topic String
 status String @default("PENDING")
 createdAt DateTime @default(now())
 @@index([childId,createdAt])
}
