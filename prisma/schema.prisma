generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String
  name              String?
  role              String   @default("parent") // parent or teacher
  isEmailVerified   Boolean  @default(false)
  verificationToken String?  @db.Text
  subscription      String   @default("FREE") // FREE or PREMIUM
  children          Child[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Child {
  id                      String    @id @default(cuid())
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                    String
  age                     Int
  dateOfBirth             DateTime?
  condition               String?
  developmentalChallenges String[]
  communicationLevel      String?   @default("Bình thường")
  avatar                  String    @default("🌻")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([userId])
}

model Resource {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String // "Kiến thức" or "Học liệu"
  ageGroup    String // JSON stringified array or comma separated string e.g. "0-3 tuổi,3-6 tuổi"
  difficulty  String // JSON stringified array or comma separated string
  format      String // "Video", "Bài viết", "PDF", "Hình ảnh"
  accessLevel String   @default("BASIC") // BASIC or PREMIUM
  imageUrl    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
