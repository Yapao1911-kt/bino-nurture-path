# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Gemini AI API Key (legacy / client-side features)
# Do not put AI secrets in VITE_ variables.

# ---------------------------------------------------------------------------
# WHO CST RAG assistant — SERVER-ONLY. Do NOT use a VITE_ prefix for these,
# or the key would be inlined into the browser bundle.
# ---------------------------------------------------------------------------
# LLM_PROVIDER: "openai" or "gemini"
LLM_PROVIDER=gemini
# One key for the active provider (OpenAI key, or Google AI Studio Gemini key).
LLM_API_KEY=
# Leave models blank to use provider defaults:
#   openai -> gpt-4o-mini / text-embedding-3-small
#   gemini -> gemini-2.0-flash / text-embedding-004
LLM_MODEL=
EMBEDDING_MODEL=

# Retrieval tuning (optional)
RAG_TOP_K=5
RAG_MIN_SCORE=0.25

# Prisma PostgreSQL (server only)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/bino?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/bino?sslmode=require
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BINO_SESSION_SECRET=
BINO_OPERATOR_EMAIL=
APP_URL=http://localhost:8082
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
