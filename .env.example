# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Gemini AI API Key (legacy / client-side features)
VITE_GEMINI_API_KEY=your_gemini_api_key

# ---------------------------------------------------------------------------
# WHO CST RAG assistant — SERVER-ONLY. Do NOT use a VITE_ prefix for these,
# or the key would be inlined into the browser bundle.
# ---------------------------------------------------------------------------
# LLM_PROVIDER: "openai" or "gemini"
LLM_PROVIDER=gemini
# One key for the active provider (OpenAI key, or Google AI Studio Gemini key).
LLM_API_KEY=
# Leave models blank to use provider defaults:
#   openai -> gpt-4o-mini / text-embedding-3-small
#   gemini -> gemini-2.0-flash / text-embedding-004
LLM_MODEL=
EMBEDDING_MODEL=

# Retrieval tuning (optional)
RAG_TOP_K=5
RAG_MIN_SCORE=0.25
