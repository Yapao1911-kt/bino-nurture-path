generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String
  name              String?
  role              String   @default("parent") // parent or teacher
  isEmailVerified   Boolean  @default(false)
  verificationToken String?  @db.Text
  subscription      String   @default("FREE") // FREE or PREMIUM
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Resource {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String // "Kiến thức" or "Học liệu"
  ageGroup    String // JSON stringified array or comma separated string e.g. "0-3 tuổi,3-6 tuổi"
  difficulty  String // JSON stringified array or comma separated string
  format      String // "Video", "Bài viết", "PDF", "Hình ảnh"
  accessLevel String   @default("BASIC") // BASIC or PREMIUM
  imageUrl    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
